logger = logging.getLogger("football-collector")


def validate_iso_date(value: str, field_name: str) -> str:
    try:
        date.fromisoformat(value)
        return value
    except ValueError as exc:
        raise HTTPException(
            status_code=422,
            detail=f"{field_name} must use YYYY-MM-DD format",
        ) from exc


app = FastAPI(
