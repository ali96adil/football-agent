# Copy to .env on the Raspberry Pi. Never commit the real .env or any dump.
TZ=Asia/Baghdad

# Existing PostgreSQL bootstrap identity. On the current Pi these remain n8n.
# They must never be assumed to identify the Football Intelligence database.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_POSTGRES_PASSWORD

# The project database is always explicit.
APP_DB_NAME=football_intelligence
APP_DB_USER=football_app
APP_DB_PASSWORD=REPLACE_WITH_FOOTBALL_APP_PASSWORD

# Provider keys are optional and remain only in this untracked file.
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
SPORTMONKS_API_KEY=
THESPORTSDB_API_KEY=

# Proxy is the only host port and is intentionally reachable from the LAN.
PROXY_BIND_ADDRESS=0.0.0.0
PROXY_HTTP_PORT=8088

# Optional compatibility profiles; n8n is not started by default.
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false

# Conservative Raspberry Pi limits and queue operation.
LOG_LEVEL=INFO
PROXY_MEMORY_LIMIT=96m
PROXY_CPU_LIMIT=0.25
POSTGRES_MEMORY_LIMIT=900m
POSTGRES_CPU_LIMIT=1.25
API_MEMORY_LIMIT=512m
API_CPU_LIMIT=0.75
WORKER_MEMORY_LIMIT=320m
WORKER_CPU_LIMIT=0.50
FRONTEND_MEMORY_LIMIT=420m
FRONTEND_CPU_LIMIT=0.75
WORKER_ID=football-worker-1
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LEASE_SECONDS=120
